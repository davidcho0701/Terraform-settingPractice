# 이 파일을 terraform.tfvars 로 복사한 뒤 필요한 값만 수정하세요.
#   cp terraform.tfvars.example terraform.tfvars

# named profile 을 쓰는 경우 (환경변수 AWS_PROFILE 을 export 했다면 deploy.sh 가 알아서 전달하므로 생략 가능)
# aws_profile = "my-mfa-profile"

cluster_name = "eks-lab"

# [보안 권장] 내 공인 IP 로 제한하세요.  확인: curl https://checkip.amazonaws.com
# grafana_allowed_cidrs                = ["203.0.113.10/32"]
# cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]

# [비용 절감 옵션]
# node_capacity_type   = "SPOT"       # 노드 비용 60~70% 절감 (회수될 수 있음)
# grafana_service_type = "ClusterIP"  # NLB 없이 port-forward 로만 접속
# node_desired_size    = 1            # 노드 1대 (파드 한도 17개라 빠듯함)
